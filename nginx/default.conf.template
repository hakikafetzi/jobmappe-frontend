# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only defined environment variables are replaced, so nginx variables like $host stay untouched.

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Resolve the backend per request (DNS from /etc/resolv.conf), so nginx also starts while the
    # backend is down or not yet created.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    # The API, Swagger UI (/swagger-ui.html redirects to /swagger-ui/index.html) and the OpenAPI docs
    # (incl. /v3/api-docs/swagger-config) are proxied with their path unchanged; /actuator stays
    # unreachable from here and falls through to the SPA fallback.
    location /api/ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location = /swagger-ui.html {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location /swagger-ui/ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location /v3/api-docs {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Hashed build output never changes under the same name; missing files must 404, not fall back to
    # index.html (which would then be cached as immutable).
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Always revalidate, so a deploy is picked up on the next load.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # SPA fallback: client-side routes like /stellen/123 serve index.html on reload.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
